generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id           Int          @id @default(autoincrement())
  name         String
  status       String
  progress     Int          @default(0)
  createdAt    DateTime     @default(now()) @map("created_at")
  tasks        Task[]
  teamMembers  TeamMember[]
  materials    Material[]
  expenses     Expense[]
  documents    Document[]

  @@map("projects")
}

model Task {
  id         Int      @id @default(autoincrement())
  title      String
  projectId  Int      @map("project_id")
  status     String
  priority   String
  createdAt  DateTime @default(now()) @map("created_at")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("tasks")
}

model TeamMember {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  role       String
  projectId  Int?     @map("project_id")
  status     String   @default("Invited")
  createdAt  DateTime @default(now()) @map("created_at")
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("team_members")
}

model Material {
  id         Int      @id @default(autoincrement())
  name       String
  category   String
  projectId  Int?     @map("project_id")
  quantity   Float    @default(0)
  unit       String
  reorderAt  Float    @default(0) @map("reorder_at")
  createdAt  DateTime @default(now()) @map("created_at")
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("materials")
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  projectId   Int?     @map("project_id")
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @map("expense_date")
  status      String   @default("Pending")
  createdAt   DateTime @default(now()) @map("created_at")
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("expenses")
}

model Document {
  id         Int      @id @default(autoincrement())
  name       String
  type       String
  projectId  Int?     @map("project_id")
  owner      String
  status     String   @default("In review")
  createdAt  DateTime @default(now()) @map("created_at")
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("documents")
}
